# Copy to .env for local development (npm run dev). On the host, set these as
# environment variables instead.

# Phase 2: change these two, then restart once.
ADMIN_PASSWORD=BCIT12
SECRET=defaultSecret

# Signing key for JWTs. Set once, never change: changing it invalidates every
# issued token, which the rules forbid. Generate with: npm run credentials
JWT_KEY=replace-with-at-least-32-random-characters

# Exact origin(s) of the deployed frontend, comma separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Number of proxies in front of the app that append the caller's address to
# X-Forwarded-For. 1 for a typical PaaS, 0 when clients connect directly.
TRUSTED_PROXY_HOPS=1
